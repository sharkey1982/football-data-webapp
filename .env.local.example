# Copy this file to .env.local and fill in your real values.
# Get these from your Supabase dashboard: Settings -> API Keys
# Use the PUBLISHABLE key here -- never the secret key in a frontend app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxx

# Canonical production origin and brand name (see src/lib/siteConfig.ts) --
# used to build canonical <link> tags, absolute URLs, and <title>/<meta>
# suffixes. Optional locally (sensible defaults kick in); set both in
# Netlify's environment for production once a canonical domain is live.
# VITE_SITE_URL=https://fixtureshark.com
# VITE_BRAND_NAME=FixtureShark
